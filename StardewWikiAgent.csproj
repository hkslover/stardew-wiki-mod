<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>StardewWikiAgent</RootNamespace>
    <AssemblyName>StardewWikiAgent</AssemblyName>
    <ModFolderName>StardewWikiAgent</ModFolderName>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Stardew/SMAPI requires net6.0; the OpenAI SDK's transitive packages use their netstandard2.0 assets. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- Bundle SDK/runtime dependencies plus third-party assemblies into the mod folder. -->
    <BundleExtraAssemblies>System,ThirdParty</BundleExtraAssemblies>
    <!-- A safety net for stale output produced before platform-specific runtime selection was enabled. -->
    <IgnoreModFilePatterns>^runtimes/</IgnoreModFilePatterns>

    <SherpaOnnxVersion>1.13.4</SherpaOnnxVersion>
    <PortAudioSharpVersion>1.0.6</PortAudioSharpVersion>

    <!--
      Select native speech libraries for the game process before NuGet resolves build assets.
      Stardew Valley is x64 on these desktop platforms; on Apple Silicon it runs through Rosetta 2.
      An explicit -p:RuntimeIdentifier=... still takes precedence for supported cross-builds.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Preserve the existing bin/{Configuration}/net6.0 layout expected by the build scripts. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />

    <!--
      The managed wrapper packages depend on native packages for every supported platform. Download
      just their managed assemblies, then reference only the runtime packages selected below.
    -->
    <PackageDownload Include="org.k2fsa.sherpa.onnx" Version="[$(SherpaOnnxVersion)]" />
    <PackageDownload Include="PortAudioSharp2" Version="[$(PortAudioSharpVersion)]" />
    <Reference Include="sherpa-onnx"
               HintPath="$(NuGetPackageRoot)/org.k2fsa.sherpa.onnx/$(SherpaOnnxVersion)/lib/net6.0/sherpa-onnx.dll"
               Private="true" />
    <Reference Include="PortAudioSharp"
               HintPath="$(NuGetPackageRoot)/portaudiosharp2/$(PortAudioSharpVersion)/lib/net6.0/PortAudioSharp.dll"
               Private="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="$(SherpaOnnxVersion)" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-x64" Version="$(PortAudioSharpVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SherpaOnnxVersion)" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.win-x64" Version="$(PortAudioSharpVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="$(SherpaOnnxVersion)" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.linux-x64" Version="$(PortAudioSharpVersion)" />
  </ItemGroup>

  <!-- Bundle the local ASR model (downloaded into ./models, gitignored) into the mod's assets/asr folder. -->
  <ItemGroup>
    <None Include="models/sherpa-onnx-streaming-zipformer-small-ctc-zh-int8-2025-04-01/model.int8.onnx"
          Link="assets/asr/model.int8.onnx"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('models/sherpa-onnx-streaming-zipformer-small-ctc-zh-int8-2025-04-01/model.int8.onnx')" />
    <None Include="models/sherpa-onnx-streaming-zipformer-small-ctc-zh-int8-2025-04-01/tokens.txt"
          Link="assets/asr/tokens.txt"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('models/sherpa-onnx-streaming-zipformer-small-ctc-zh-int8-2025-04-01/tokens.txt')" />
  </ItemGroup>

  <Target Name="PrepareSpeechNativeRuntime" BeforeTargets="PrepareForBuild;_CopyFilesMarkedCopyLocal">
    <Error Condition="'$(RuntimeIdentifier)' != 'osx-x64' and '$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'linux-x64'"
           Text="Unsupported speech runtime '$(RuntimeIdentifier)'. Supported values: osx-x64, win-x64, linux-x64." />
    <Message Importance="high" Text="[speech] Native runtime: $(RuntimeIdentifier)" />
    <!-- Remove multi-platform output left by builds made before RID filtering was enabled. -->
    <RemoveDir Directories="$(TargetDir)runtimes" Condition="Exists('$(TargetDir)runtimes')" />
  </Target>
</Project>
